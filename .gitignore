out
*.txt

# Terraform: provider plugins are re-fetched by `init`, state and plans can contain secrets,
# and tfvars name real infrastructure. The lock file is committed on purpose.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Per-environment policy (memory, retention, session length) is a reviewable decision, not an
# account fact, so these are committed while *.tfvars is not.
!*.settings.tfvars
crash.log

# Scala.js output symlinked next to index.html for local serving.
matchmaker/ui/main.js
matchmaker/ui/main.js.map
matchmaker/ui/config.js
