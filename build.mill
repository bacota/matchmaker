package build

import mill._, scalalib._, scalajslib._

/** Sources compiled for both the JVM API and the Scala.js UI.
  *
  * Two directories, neither of which may use anything outside the standard library and
  * `java.time`: `model`, and `api/Json.scala`, which is the wire format. Sharing the codecs
  * rather than restating them in the UI is the point — a field renamed on one side then fails to
  * compile on the other instead of failing at runtime as a missing key.
  *
  * Both modules that use it sit at `matchmaker/<name>`, so the repository root is two levels up.
  */
def sharedSources(moduleDir: os.Path): Seq[os.Path] = {
  val root = moduleDir / os.up / os.up
  Seq(root / "shared" / "src", root / "matchmaker" / "src" / "com" / "vivi" / "matchmaker" / "model")
}

/** A properties file of text a person reads as the source of a Scala object: `game.roles` becomes
  * `<objectName>.game.roles`, and a value with `{name}` in it a method taking `name`. Compiled rather than fetched at run
  * time, so a key the code asks for and the file lacks, or a placeholder renamed on one side only, fails the build
  * instead of showing nothing. The object is `private[ui]` in the UI's package unless `pkg` and `modifier` say otherwise.
  *
  * With `canBeMissing`, a key the code asks for and the file lacks is `""` instead, whatever it would be given to fill:
  * for the tips, where a tip the file leaves out is not shown.
  *
  * `overrides` is a second file, an engine's own, whose keys add to `file`'s and replace the ones it shares with it.
  * A replacement keeps the original's parameters, so it may leave a placeholder out but not add one.
  *
  * With `runtimeOverrides`, the path of a classpath resource, the object takes the text of a key that resource has
  * from it when it is first used, and its own only where the resource has none: for engines.common, whose code is
  * compiled once and says what the engine it runs in has its file say instead.
  */
def textObject(
    file: os.Path,
    objectName: String,
    example: String,
    pkg: String = "com.vivi.matchmaker.ui",
    modifier: String = "private[ui] ",
    canBeMissing: Boolean = false,
    overrides: Option[os.Path] = None,
    runtimeOverrides: Option[String] = None
): String = {
  val name = "[a-z][A-Za-z0-9]*"
  val placeholder = ("\\{(" + name + ")\\}").r
  def named(file: os.Path) = file.relativeTo(mill.api.BuildCtx.workspaceRoot).toString
  def load(file: os.Path): Map[String, String] = {
    val props = new java.util.Properties
    val in = java.nio.file.Files.newBufferedReader(file.toNIO, java.nio.charset.StandardCharsets.UTF_8)
    try props.load(in)
    finally in.close()
    val entries = props.stringPropertyNames().toArray(Array.empty[String]).toSeq.map(k => k -> props.getProperty(k))
    entries.foreach { (key, text) =>
      if (!key.matches(name + "\\." + name))
        throw new Exception(s"${named(file)}: '$key' is not two names joined by a dot, such as $example")
      if (key.startsWith("keys.")) throw new Exception(s"${named(file)}: 'keys' is taken, by the list of every key")
      if (placeholder.replaceAllIn(text, "").exists(c => c == '{' || c == '}'))
        throw new Exception(s"${named(file)}: $key has a brace that is not part of a {name}")
    }
    entries.toMap
  }
  def placeholders(text: String) = placeholder.findAllMatchIn(text).map(_.group(1)).toSeq.distinct
  def literal(s: String) =
    "\"" + s.flatMap {
      case '\\' => "\\\\"
      case '"'  => "\\\""
      case '\n' => "\\n"
      case c    => c.toString
    } + "\""
  val base = load(file)
  val over = overrides.map(load).getOrElse(Map.empty)
  over.foreach { (key, text) =>
    base.get(key).foreach { original =>
      placeholders(text).filterNot(placeholders(original).contains).foreach { added =>
        throw new Exception(
          s"${named(overrides.get)}: $key uses {$added}, which ${named(file)}'s $key is not given to fill"
        )
      }
    }
  }
  val texts = base ++ over
  val keys = texts.keys.toSeq.sorted
  val objects = keys.groupBy(_.takeWhile(_ != '.')).toSeq.sortBy(_._1).map { (screen, inScreen) =>
    val members = inScreen.map { key =>
      val member = key.drop(screen.length + 1)
      val text = texts(key)
      val params = placeholders(base.getOrElse(key, text))
      val signature = params.map(p => s"`$p`: String").mkString(", ")
      if (runtimeOverrides.nonEmpty) {
        if (params.isEmpty) s"    val `$member`: String = Overrides.text(${literal(key)}, ${literal(text)})"
        else {
          val fills = params.map(p => s"${literal(p)} -> `$p`").mkString(", ")
          s"    def `$member`($signature): String = Overrides.fill(${literal(key)}, ${literal(text)}, Map($fills))"
        }
      } else if (params.isEmpty) s"    val `$member`: String = ${literal(text)}"
      else {
        val pieces = placeholder.split(text).toSeq.map(literal)
        val names = placeholder.findAllMatchIn(text).map(_.group(1)).toSeq
        val body = pieces.zipAll(names, "\"\"", "").flatMap((p, n) => Seq(p) ++ Option.when(n.nonEmpty)(s"`$n`"))
        s"    def `$member`($signature): String = ${body.mkString(" + ")}"
      }
    }
    val parent = if (canBeMissing) " extends Missing" else ""
    s"  object `$screen`$parent {\n${members.mkString("\n")}\n  }"
  }
  // A screen or a key the file lacks, found by `Dynamic` only when there is no such member.
  val missing =
    if (!canBeMissing) Nil
    else
      Seq(
        "  trait Missing extends Dynamic {\n" +
          "    def selectDynamic(key: String): String = \"\"\n" +
          "    def applyDynamic(key: String)(fills: Any*): String = \"\"\n" +
          "    def applyDynamicNamed(key: String)(fills: (String, Any)*): String = \"\"\n" +
          "  }",
        "  def selectDynamic(screen: String): Missing = new Missing {}"
      )
  // The text the engine's own file gives instead, read once; a screen's name starts in lower case, so none is this.
  val lookup = runtimeOverrides.toSeq.map { resource =>
    "  private object Overrides {\n" +
      "    private val props = new java.util.Properties\n" +
      s"    Option(getClass.getResourceAsStream(${literal("/" + resource)})).foreach { in =>\n" +
      "      val reader = new java.io.InputStreamReader(in, java.nio.charset.StandardCharsets.UTF_8)\n" +
      "      try props.load(reader)\n" +
      "      finally reader.close()\n" +
      "    }\n" +
      "    def text(key: String, default: String): String = props.getProperty(key, default)\n" +
      "    def fill(key: String, default: String, fills: Map[String, String]): String =\n" +
      "      \"\\\\{([a-z][A-Za-z0-9]*)\\\\}\".r.replaceAllIn(\n" +
      "        text(key, default),\n" +
      "        m => java.util.regex.Matcher.quoteReplacement(fills(m.group(1)))\n" +
      "      )\n" +
      "  }"
  }
  // Every key, for checking a format's form overrides (`StandardModel.formOverrides`) name one there is.
  val keySet = s"  val keys: Set[String] = Set(\n${keys.map(k => "    " + literal(k)).mkString(",\n")}\n  )"
  val sources = (file +: overrides.toSeq).map(named).mkString(" and ")
  s"package $pkg\n\n" +
    (if (canBeMissing) "import scala.language.dynamics\n\n" else "") +
    s"/** Generated from $sources by build.mill: edit that, not this. */\n" +
    s"${modifier}object $objectName${if (canBeMissing) " extends Dynamic" else ""} {\n" +
    s"${(missing ++ lookup ++ objects :+ keySet).mkString("\n\n")}\n}\n"
}

/** Matchmaker's `errors.properties` as `com.vivi.matchmaker.ErrorText`, for the JVM modules and the UI alike. */
def errorText(file: os.Path): String =
  textObject(file = file, objectName = "ErrorText", example = "game.notFound", pkg = "com.vivi.matchmaker", modifier = "")

object matchmaker extends ScalaModule {
  def scalaVersion = "3.3.8"

  /** The text of every error and warning matchmaker gives, in one file to be edited without touching the code: shared
    * with the UI, which compiles the model that raises some of them and shows its own beside them.
    */
  def errorsFile = Task.Source(moduleDir / "errors.properties")

  /** `errors.properties` as `com.vivi.matchmaker.ErrorText`; see [[textObject]]. */
  def generatedSources = Task {
    os.write(Task.dest / "ErrorText.scala", errorText(errorsFile().path))
    super.generatedSources() ++ Seq(PathRef(Task.dest))
  }

  /** skunk brings twiddles-core, which declares munit at *compile* scope rather than test (an
    * upstream packaging slip), and its SCRAM client does the same with junit. Left alone, a test
    * framework ends up inside the deployed artifact.
    */
  def mvnDeps = Seq(
    mvn"org.tpolecat::skunk-core:1.0.0"
      .exclude(
        ("org.scalameta", "munit_3"),
        ("org.scalameta", "munit-diff_3"),
        ("org.scalameta", "junit-interface"),
        ("junit", "junit"),
        ("org.hamcrest", "hamcrest-core")
      ),
    mvn"org.tpolecat::natchez-core:0.3.10",
    // For the jsonb columns this module reads and writes as structured data (result.scores).
    // Already inside the deployed jar by way of `api`, so this costs nothing there.
    mvn"com.lihaoyi::upickle:4.0.2",
    /* The one AWS call matchmaker makes for itself: putting a notification on the mail queue.
     *
     * A real client here, unlike everywhere else in this repository, and SnapStart is the reason.
     * Signing by hand means reading the execution role's credentials out of the environment, and a
     * restored JVM cannot see the environment it was restored into -- Java fixes System.getenv at
     * startup, which under SnapStart is publish time. The client's credential provider is built to
     * survive that; a `System.getenv` call is not. See SqsNotifier.
     *
     * The two HTTP clients the SDK would otherwise drag in are excluded, and the JDK's own
     * URLConnection transport used instead: Netty and Apache are several megabytes each, for one
     * JSON call with no streaming and no connection pooling worth the name.
     */
    mvn"software.amazon.awssdk:sqs:2.31.78"
      .exclude(
        ("software.amazon.awssdk", "netty-nio-client"),
        ("software.amazon.awssdk", "apache-client")
      ),
    mvn"software.amazon.awssdk:url-connection-client:2.31.78",
    /* Archives of completed matches (archiving-matches-plan.md): signing the urls an engine uploads
     * and downloads with, and checking that an object is there. A client for the same SnapStart
     * reason as SQS above, and with the same two HTTP clients left out. */
    mvn"software.amazon.awssdk:s3:2.31.78"
      .exclude(
        ("software.amazon.awssdk", "netty-nio-client"),
        ("software.amazon.awssdk", "apache-client")
      )
  )

  object test extends ScalaTests with TestModule.Munit {
    def mvnDeps = Seq(
      mvn"org.scalameta::munit:1.0.4",
      mvn"org.scalameta::munit-scalacheck:1.0.0",
      mvn"org.typelevel::otel4s-core-trace:0.11.2",
      mvn"org.typelevel::otel4s-core-metrics:0.11.2",
      mvn"org.flywaydb:flyway-core:13.0.0",
      mvn"org.flywaydb:flyway-database-postgresql:13.0.0",
      mvn"org.postgresql:postgresql:42.7.13"
    )

    /** Brings the local test database up to date, once, before any test JVM starts.
      *
      * The specs used to do this themselves, and mill forks several JVMs per run, so Flyway ran
      * once in each of them — every one validating the same nine migrations, and all of them
      * starting at the same moment. Flyway's own locking makes that safe, but it is repeated
      * work at the point where every suite is already contending for connections, and it buried
      * the test output in migration banners.
      *
      * Re-run on every invocation, via the always-changing input below: the database is not one
      * of mill's inputs, so a plain cached task would be skipped on the run after someone
      * dropped the schema by hand — which is exactly the run that needs it. The module reused
      * here is the same `Migrate` that `flyway-dev.sh` runs, so the tests and the deployment
      * apply migrations one way.
      */
    def migrated = Task {
      everyInvocation()
      mill.util.Jvm.callProcess(
        mainClass = "com.vivi.matchmaker.flyway.Migrate",
        classPath = matchmaker.flyway.runClasspath().map(_.path),
        env = Map(
          "FLYWAY_PASSWORD" -> "matchmaker",
          // Absolute, because this runs in the task's own directory: a `Task` may only write
          // inside `Task.dest`, so it cannot be given the workspace as its working directory
          // and cannot use `Migrate`'s workspace-relative default.
          "MIGRATION_DIR" -> (mill.api.BuildCtx.workspaceRoot / "matchmaker" / "resources" / "db" / "migration").toString
        ),
        cwd = Task.dest,
        stdout = os.Inherit
      )
      ()
    }

    /* Nothing about the database can be expressed as a mill input, so this stands in for it:
     * a value that differs every time it is asked for, which is what stops the migration above
     * from being cached and skipped. */
    def everyInvocation = Task.Input { System.nanoTime() }

    /* The migration is a dependency of the forked JVMs' environment, which is what makes it
     * happen before they start; the variable is how `TestMigration` knows not to do it again. */
    def forkEnv = Task {
      migrated()
      super.forkEnv() + ("MATCHMAKER_TEST_MIGRATED" -> "1")
    }
  }

  /** The HTTP API, packaged as an AWS Lambda behind an API Gateway HTTP API.
    *
    * Deployable jar: `mill matchmaker.api.assembly`, whose handler is
    * `com.vivi.matchmaker.api.Handler::handleRequest`.
    *
    * `aws-lambda-java-events` is deliberately absent, to keep the cold start short: it would
    * pull in Jackson purely to model the event, which `ApiGateway` picks apart with ujson
    * instead. The same argument is why nothing here uses an AWS *service* client — that is what
    * brings in Netty and Apache HttpClient (8 MB). Nothing in this module reaches AWS at all: the
    * game engine is authenticated with a shared API key rather than SigV4, so the signer that
    * used to be here is gone with it.
    */
  object api extends ScalaModule {
    def scalaVersion = "3.3.8"
    def moduleDeps = Seq(matchmaker)
    def mvnDeps = Seq(
      mvn"com.amazonaws:aws-lambda-java-core:1.2.3",
      mvn"com.lihaoyi::upickle:4.0.2"
    )

    // Json.scala lives in shared/, compiled here and again for the UI. The model directory is
    // already on this module's path through `matchmaker`, so only the former is added.
    def sources = Task.Sources(moduleDir / "src", sharedSources(moduleDir).head)

    /** TASTy files carry Scala 3 signatures for compiling *against* this jar. Nothing compiles
      * against a Lambda artifact, and they are a fifth of its size.
      */
    def assemblyRules = super.assemblyRules ++ Seq(Assembly.Rule.ExcludePattern(".*\\.tasty"))

    object test extends ScalaTests with TestModule.Munit {
      def mvnDeps = Seq(
        mvn"org.scalameta::munit:1.0.4",
        mvn"org.typelevel::otel4s-core-trace:0.11.2",
        mvn"org.typelevel::otel4s-core-metrics:0.11.2"
      )
    }
  }

  /** The browser UI: Scala.js and Laminar, talking to the same HTTP API as any other client.
    *
    * `mill matchmaker.ui.fastLinkJS` for development, `fullLinkJS` for a deployable bundle; both
    * write `main.js` into their own out directory, which `ui/index.html` loads. There is no
    * bundler and no npm: Laminar and scalajs-dom are Scala libraries, and the only browser APIs
    * used (fetch, crypto.subtle, sessionStorage) are standard.
    *
    * It compiles the model and the API's `Json` codecs from source rather than depending on
    * `matchmaker`, which cannot cross-compile — skunk and cats-effect are JVM-only.
    */
  object ui extends ScalaJSModule {
    def scalaVersion = "3.3.8"
    def scalaJSVersion = "1.17.0"

    def sources = Task.Sources(Seq(moduleDir / "src") ++ sharedSources(moduleDir)*)

    /** The text of every "?" tip, the caption of every form field and the heading of every section, each kept in one
      * file to be edited without touching the code.
      */
    def tipsFile = Task.Source(moduleDir / "tips.properties")
    def labelsFile = Task.Source(moduleDir / "labels.properties")
    def headingsFile = Task.Source(moduleDir / "headings.properties")
    def errorsFile = Task.Source(moduleDir / os.up / "errors.properties")

    /** `tips.properties` as `object Tips`, `labels.properties` as `object Labels` and `headings.properties` as
      * `object Headings`, and matchmaker's `errors.properties` as `ErrorText`, as the model compiled here uses it; see
      * [[textObject]].
      */
    def generatedSources = Task {
      os.write(Task.dest / "ErrorText.scala", errorText(errorsFile().path))
      os.write(
        Task.dest / "Tips.scala",
        textObject(file = tipsFile().path, objectName = "Tips", example = "game.roles", canBeMissing = true)
      )
      os.write(
        Task.dest / "Labels.scala",
        textObject(file = labelsFile().path, objectName = "Labels", example = "game.name")
      )
      os.write(
        Task.dest / "Headings.scala",
        textObject(file = headingsFile().path, objectName = "Headings", example = "account.nickname")
      )
      super.generatedSources() ++ Seq(PathRef(Task.dest))
    }

    def mvnDeps = Seq(
      mvn"org.scala-js::scalajs-dom::2.8.0",
      mvn"com.raquo::laminar::17.2.0",
      mvn"com.lihaoyi::upickle::4.0.2",
      // The shared model uses java.time, which Scala.js does not implement itself.
      mvn"io.github.cquiroz::scala-java-time::2.6.0"
    )

    /** A module rather than a plain script, so that `fullLinkJS` can split output and so that
      * `index.html` can `import` it — Scala.js's default is a single non-module script, which
      * cannot be loaded with `type="module"`.
      */
    def moduleKind = mill.scalajslib.api.ModuleKind.ESModule

    object test extends ScalaJSTests with TestModule.Munit {
      def mvnDeps = Seq(mvn"org.scalameta::munit::1.0.4")
    }
  }

  /** The mail queue's consumer, packaged as an AWS Lambda behind an SQS event source mapping.
    *
    * Deployable jar: `mill -j 4 --ticker false matchmaker.mailer.assembly`, whose handler is
    * `com.vivi.matchmaker.mailer.Handler::handleRequest`.
    *
    * Depends on nothing else in the repository, deliberately. It receives a sender, a recipient,
    * a subject and a body, and calls SES; it has no database, no model and no notion of a game,
    * which is what keeps it a small jar with a short cold start and what lets every later kind of
    * notification reuse it untouched. `MailMessage` is restated here rather than shared for that
    * reason, and its test module — the only thing here that depends on `matchmaker` — is what
    * keeps the two statements of it honest, exactly as the engines' `ProtocolSpec` does.
    */
  object mailer extends ScalaModule {
    def scalaVersion = "3.3.8"

    def mvnDeps = Seq(
      mvn"com.amazonaws:aws-lambda-java-core:1.2.3",
      mvn"com.lihaoyi::upickle:4.0.2",
      // The signer, not an SES client, for the reason `api` gives about service clients.
      mvn"software.amazon.awssdk:http-auth-aws:2.31.78",
      mvn"org.slf4j:slf4j-nop:1.7.36"
    )

    def assemblyRules = super.assemblyRules ++ Seq(Assembly.Rule.ExcludePattern(".*\\.tasty"))

    object test extends ScalaTests with TestModule.Munit {
      def moduleDeps = super.moduleDeps ++ Seq(matchmaker)
      def mvnDeps = Seq(mvn"org.scalameta::munit:1.0.4")
    }
  }

  /** Standalone module used only to run Flyway migrations (JDBC-based,
    * independent of the skunk/cats-effect runtime dependencies above).
    * Migration scripts live in matchmaker/resources/db/migration and are
    * shared via that resources directory (matchmaker's default resource path).
    */
  object flyway extends ScalaModule {
    def scalaVersion = "3.3.8"
    def mvnDeps = Seq(
      mvn"org.flywaydb:flyway-core:10.20.1",
      mvn"org.flywaydb:flyway-database-postgresql:10.20.1",
      mvn"org.postgresql:postgresql:42.7.4"
    )

    /** Run pending migrations against the database given by env vars
      * FLYWAY_URL, FLYWAY_USER, FLYWAY_PASSWORD, e.g.:
      *
      *   FLYWAY_URL=jdbc:postgresql://localhost:5432/matchmaker \
      *   FLYWAY_USER=matchmaker FLYWAY_PASSWORD=secret \
      *   ./mill matchmaker.flyway.runMain com.vivi.matchmaker.flyway.Migrate
      *
      * SeedAdmin runs the same way, on the same variables plus
      * ADMIN_EXTERNAL_ID, to give the admin Cognito user a player row.
      */
    object test extends ScalaTests with TestModule.Munit {
      def mvnDeps = Seq(mvn"org.scalameta::munit::1.0.4")
    }
  }
}

/** Game engines to develop and test matchmaker's engine interaction against.
  *
  * These are not part of matchmaker: an engine is a separate system reached over HTTP, and
  * nothing here depends on the `matchmaker` module — deliberately, since sharing the wire
  * types would hide exactly the mismatches this code exists to catch. They live in the same
  * repository only because they are worth nothing on their own.
  */
object engines extends Module {

  /** What every engine, and the library they share, is built with.
    *
    * The dependencies are the engines' whole footprint, and kept that small on purpose: each one
    * is a Lambda whose cold start is paid by a player waiting on a move.
    */
  trait EngineModule extends ScalaModule {
    def scalaVersion = "3.3.8"

    def mvnDeps = Seq(
      mvn"com.lihaoyi::upickle:4.0.2",
      mvn"com.amazonaws:aws-lambda-java-core:1.2.3",
      // Signs the engine's calls to DynamoDB, and only those — its callbacks to matchmaker carry
      // a shared API key instead. The signer only: a DynamoDB client would bring Netty with it.
      mvn"software.amazon.awssdk:http-auth-aws:2.31.78",
      // The credential chain the signer is handed: the one source of credentials that survives a
      // SnapStart restore. No HTTP client comes with it; the container endpoint is asked over the
      // JDK's own.
      mvn"software.amazon.awssdk:auth:2.31.78",
      mvn"org.slf4j:slf4j-nop:1.7.36"
    )

    def assemblyRules = super.assemblyRules ++ Seq(Assembly.Rule.ExcludePattern(".*\\.tasty"))

    /** An engine's tests, and only its tests, depend on matchmaker.
      *
      * `ProtocolSpec` reads the engine's JSON with matchmaker's own classes and matchmaker's with
      * the engine's, which is the check the restated wire types exist for: it fails when a field
      * is renamed on one side, and it is the reason the engine itself can stay independent.
      */
    trait EngineTests extends ScalaTests with TestModule.Munit {
      def moduleDeps = super.moduleDeps ++ Seq(matchmaker.api)
      def mvnDeps = Seq(
        mvn"org.scalameta::munit:1.0.4",
        mvn"org.scalameta::munit-scalacheck:1.0.0"
      )
    }
  }

  /** Where on an engine's classpath its own `errors.properties` or `headings.properties` is, for engines.common to
    * read the keys it overrides from.
    */
  def textOverrides(fileName: String): String = s"com/vivi/engine/overrides/$fileName"

  /** A game's engine, on engines.common, with its own text.
    *
    * Its `errors.properties` holds the game's errors and warnings, and its `headings.properties`, if it has one, the
    * headings it gives the pages every engine serves. Either may also give a key of common's file, to say it
    * differently in this game. Each is generated, merged with common's, into an `ErrorText` and a `Headings` in the
    * engine's own package, which its code uses in place of common's; and each is put on the classpath at
    * [[textOverrides]], from which common's own objects take what the engine overrides.
    */
  trait GameModule extends EngineModule {
    def moduleDeps = Seq(common)

    def errorsFile = Task.Source(moduleDir / "errors.properties")
    def headingsFile = Task.Source(moduleDir / "headings.properties")

    /** The engine's package, `com.vivi.<module>`. */
    def textPackage = s"com.vivi.${moduleDir.last}"

    /** The engine's files merged with common's, as its own `ErrorText` and `Headings`; see [[textObject]]. */
    def generatedSources = Task {
      os.write(
        Task.dest / "ErrorText.scala",
        textObject(
          file = common.errorsFile().path,
          objectName = "ErrorText",
          example = "matches.notFound",
          pkg = textPackage,
          modifier = "",
          overrides = Option.when(os.exists(errorsFile().path))(errorsFile().path)
        )
      )
      os.write(
        Task.dest / "Headings.scala",
        textObject(
          file = common.headingsFile().path,
          objectName = "Headings",
          example = "signIn.signIn",
          pkg = textPackage,
          modifier = "",
          overrides = Option.when(os.exists(headingsFile().path))(headingsFile().path)
        )
      )
      super.generatedSources() ++ Seq(PathRef(Task.dest))
    }

    /** The engine's own files, where engines.common looks for them. */
    def textResources = Task {
      Seq(errorsFile(), headingsFile()).map(_.path).filter(os.exists).foreach { file =>
        os.copy(file, Task.dest / os.RelPath(textOverrides(file.last)), createFolders = true)
      }
      PathRef(Task.dest)
    }

    def resources = Task { super.resources() ++ Seq(textResources()) }
  }

  /** What every engine has in common and no game decides: the wire format to and from matchmaker,
    * the Lambda event, signed HTTP, the player sign-in, the match store and the callbacks.
    *
    * Like the engines, it does not depend on `matchmaker` — the wire types are restated here, once,
    * rather than shared — and its `ProtocolSpec` is where the two statements are compared.
    */
  object common extends EngineModule {

    /** The text of every error and warning the engines give alike: matchmaker's file is not theirs to depend on, any
      * more than its code is. A game's own are in its own `errors.properties`; see [[GameModule]].
      */
    def errorsFile = Task.Source(moduleDir / "errors.properties")

    /** The headings of the pages every engine serves alike, such as the sign-in; a game's own page keeps its own. */
    def headingsFile = Task.Source(moduleDir / "headings.properties")

    /** `errors.properties` as `com.vivi.engine.ErrorText`, and `headings.properties` as `com.vivi.engine.Headings`;
      * see [[textObject]]. Each takes a key the engine it runs in says otherwise from that engine's file, which
      * [[GameModule]] puts on the classpath at [[textOverrides]].
      */
    def generatedSources = Task {
      os.write(
        Task.dest / "ErrorText.scala",
        textObject(
          file = errorsFile().path,
          objectName = "ErrorText",
          example = "matches.notFound",
          pkg = "com.vivi.engine",
          modifier = "",
          runtimeOverrides = Some(textOverrides("errors.properties"))
        )
      )
      os.write(
        Task.dest / "Headings.scala",
        textObject(
          file = headingsFile().path,
          objectName = "Headings",
          example = "signIn.signIn",
          pkg = "com.vivi.engine",
          modifier = "",
          runtimeOverrides = Some(textOverrides("headings.properties"))
        )
      )
      super.generatedSources() ++ Seq(PathRef(Task.dest))
    }

    // Takes the testkit for `QuietTests`, as the engines' tests do.
    object test extends EngineTests {
      def moduleDeps = super.moduleDeps ++ Seq(testkit)
    }

    /** What every engine's tests check the same way, for each engine's own tests to run against
      * its game: `RoutesContract`, the routes every engine serves.
      *
      * A module rather than part of `common.test` so that an engine's tests can depend on it
      * without taking common's own suites with them.
      */
    object testkit extends EngineModule {
      def moduleDeps = Seq(common)
      def mvnDeps = super.mvnDeps() ++ Seq(mvn"org.scalameta::munit:1.0.4")
    }
  }

  /** Two-player tic-tac-toe, implementing the game API of `interaction-design.txt`.
    *
    * `mill -j 4 --ticker false engines.tictactoe.runMain com.vivi.tictactoe.LocalServer` runs it
    * locally; `mill -j 4 --ticker false engines.tictactoe.assembly` builds the Lambda jar, whose
    * handler is `com.vivi.tictactoe.Handler::handleRequest`.
    */
  object tictactoe extends GameModule {
    object test extends EngineTests {
      def moduleDeps = super.moduleDeps ++ Seq(common.testkit)
    }
  }

  /** Two-player rock-paper-scissors, implementing the same game API as `tictactoe`.
    *
    * The second engine, and the one that exercises what the first cannot: a game with no turn
    * order. Both seats are pending at once, either player may move first, and the match resolves
    * on the second throw — which is matchmaker's simultaneous-turn handling (a list of pending
    * seats, a move callback that names nobody as next) played for real over HTTP.
    *
    * `mill -j 4 --ticker false engines.rps.runMain com.vivi.rps.LocalServer` runs it locally;
    * `mill -j 4 --ticker false engines.rps.assembly` builds the Lambda jar, whose handler is
    * `com.vivi.rps.Handler::handleRequest`.
    */
  object rps extends GameModule {
    object test extends EngineTests {
      def moduleDeps = super.moduleDeps ++ Seq(common.testkit)
    }
  }

  /** Two fighters, each built by their player, trading simultaneous round plans over 3 to 25 rounds — the rules are
    * `boxing.txt`, and the README beside the sources says how they are played here.
    *
    * The first character game among the engines: every corner is a matchmaker character (a *fighter*), whose
    * characteristics the engine writes back to matchmaker as the character's state once the player has built it.
    *
    * `mill -j 4 --ticker false engines.boxing.runMain com.vivi.boxing.LocalServer` runs it locally;
    * `mill -j 4 --ticker false engines.boxing.assembly` builds the Lambda jar, whose handler is
    * `com.vivi.boxing.Handler::handleRequest`.
    */
  object boxing extends GameModule {
    object test extends EngineTests {
      def moduleDeps = super.moduleDeps ++ Seq(common.testkit)
    }
  }

  /** Two-player Stratego — classic rules, a 10x10 board and 40 pieces a side — implementing the same game API.
    *
    * The engine that exercises hidden information for a whole match rather than for one throw: what each player and
    * the public board may see is decided per square, on every read. It also has two phases, a simultaneous setup and
    * then alternating turns, so both shapes of pending list occur in one match.
    *
    * `mill -j 4 --ticker false engines.stratego.runMain com.vivi.stratego.LocalServer` runs it locally;
    * `mill -j 4 --ticker false engines.stratego.assembly` builds the Lambda jar, whose handler is
    * `com.vivi.stratego.Handler::handleRequest`.
    */
  object stratego extends GameModule {
    object test extends EngineTests {
      def moduleDeps = super.moduleDeps ++ Seq(common.testkit)
    }
  }

  /** Waving Hands, Richard Bartle's duel of wizards: spells made of hand gestures, every wizard's orders given in
    * secret and carried out at once. A game without roles, for two or more wizards.
    *
    * `mill -j 4 --ticker false engines.wavinghands.runMain com.vivi.wavinghands.LocalServer` runs it locally;
    * `mill -j 4 --ticker false engines.wavinghands.assembly` builds the Lambda jar, whose handler is
    * `com.vivi.wavinghands.Handler::handleRequest`.
    */
  object wavinghands extends GameModule {
    object test extends EngineTests {
      def moduleDeps = super.moduleDeps ++ Seq(common.testkit)
    }
  }

  /** Hilo: every player picks a number from 1 to the number of players, all at once, and the highest number nobody
    * else picked wins. A game without roles, for two or more players, and the simplest one that is.
    *
    * `mill -j 4 --ticker false engines.hilo.runMain com.vivi.hilo.LocalServer` runs it locally;
    * `mill -j 4 --ticker false engines.hilo.assembly` builds the Lambda jar, whose handler is
    * `com.vivi.hilo.Handler::handleRequest`.
    */
  object hilo extends GameModule {
    object test extends EngineTests {
      def moduleDeps = super.moduleDeps ++ Seq(common.testkit)
    }
  }
}
