package build

import mill._, scalalib._

object matchmaker extends ScalaModule {
  def scalaVersion = "3.3.8"

  /** skunk brings twiddles-core, which declares munit at *compile* scope rather than test (an
    * upstream packaging slip), and its SCRAM client does the same with junit. Left alone, a test
    * framework ends up inside the deployed artifact.
    */
  def mvnDeps = Seq(
    mvn"org.tpolecat::skunk-core:1.0.0"
      .exclude(
        ("org.scalameta", "munit_3"),
        ("org.scalameta", "munit-diff_3"),
        ("org.scalameta", "junit-interface"),
        ("junit", "junit"),
        ("org.hamcrest", "hamcrest-core")
      ),
    mvn"org.tpolecat::natchez-core:0.3.10"
  )

  object test extends ScalaTests with TestModule.Munit {
    def mvnDeps = Seq(
      mvn"org.scalameta::munit:1.0.4",
      mvn"org.scalameta::munit-scalacheck:1.0.0",
      mvn"org.typelevel::otel4s-core-trace:0.11.2",
      mvn"org.typelevel::otel4s-core-metrics:0.11.2",
      mvn"org.flywaydb:flyway-core:13.0.0",
      mvn"org.flywaydb:flyway-database-postgresql:13.0.0",
      mvn"org.postgresql:postgresql:42.7.13"
    )
  }

  /** The HTTP API, packaged as an AWS Lambda behind an API Gateway HTTP API.
    *
    * Deployable jar: `mill matchmaker.api.assembly`, whose handler is
    * `com.vivi.matchmaker.api.Handler::handleRequest`.
    *
    * Two dependencies are deliberately absent, both to keep the cold start short:
    * `aws-lambda-java-events`, which would pull in Jackson purely to model the event; and the AWS
    * SDK, which would pull in Netty and Apache HttpClient (8 MB) to make one call per cold start.
    * The secret is fetched from the Parameters and Secrets Lambda Extension instead — see
    * `Handler.credentials`.
    */
  object api extends ScalaModule {
    def scalaVersion = "3.3.8"
    def moduleDeps = Seq(matchmaker)
    def mvnDeps = Seq(
      mvn"com.amazonaws:aws-lambda-java-core:1.2.3",
      mvn"com.lihaoyi::upickle:4.0.2"
    )

    /** TASTy files carry Scala 3 signatures for compiling *against* this jar. Nothing compiles
      * against a Lambda artifact, and they are a fifth of its size.
      */
    def assemblyRules = super.assemblyRules ++ Seq(Assembly.Rule.ExcludePattern(".*\\.tasty"))

    object test extends ScalaTests with TestModule.Munit {
      def mvnDeps = Seq(
        mvn"org.scalameta::munit:1.0.4",
        mvn"org.typelevel::otel4s-core-trace:0.11.2",
        mvn"org.typelevel::otel4s-core-metrics:0.11.2"
      )
    }
  }

  /** Standalone module used only to run Flyway migrations (JDBC-based,
    * independent of the skunk/cats-effect runtime dependencies above).
    * Migration scripts live in matchmaker/resources/db/migration and are
    * shared via that resources directory (matchmaker's default resource path).
    */
  object flyway extends ScalaModule {
    def scalaVersion = "3.3.8"
    def mvnDeps = Seq(
      mvn"org.flywaydb:flyway-core:10.20.1",
      mvn"org.flywaydb:flyway-database-postgresql:10.20.1",
      mvn"org.postgresql:postgresql:42.7.4"
    )

    /** Run pending migrations against the database given by env vars
      * FLYWAY_URL, FLYWAY_USER, FLYWAY_PASSWORD, e.g.:
      *
      *   FLYWAY_URL=jdbc:postgresql://localhost:5432/matchmaker \
      *   FLYWAY_USER=matchmaker FLYWAY_PASSWORD=secret \
      *   ./mill matchmaker.flyway.runMain com.vivi.matchmaker.flyway.Migrate
      */
  }
}
