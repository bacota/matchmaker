package build

import mill._, scalalib._, scalajslib._

/** Sources compiled for both the JVM API and the Scala.js UI.
  *
  * Two directories, neither of which may use anything outside the standard library and
  * `java.time`: `model`, and `api/Json.scala`, which is the wire format. Sharing the codecs
  * rather than restating them in the UI is the point — a field renamed on one side then fails to
  * compile on the other instead of failing at runtime as a missing key.
  *
  * Both modules that use it sit at `matchmaker/<name>`, so the repository root is two levels up.
  */
def sharedSources(moduleDir: os.Path): Seq[os.Path] = {
  val root = moduleDir / os.up / os.up
  Seq(root / "shared" / "src", root / "matchmaker" / "src" / "com" / "vivi" / "matchmaker" / "model")
}

object matchmaker extends ScalaModule {
  def scalaVersion = "3.3.8"

  /** skunk brings twiddles-core, which declares munit at *compile* scope rather than test (an
    * upstream packaging slip), and its SCRAM client does the same with junit. Left alone, a test
    * framework ends up inside the deployed artifact.
    */
  def mvnDeps = Seq(
    mvn"org.tpolecat::skunk-core:1.0.0"
      .exclude(
        ("org.scalameta", "munit_3"),
        ("org.scalameta", "munit-diff_3"),
        ("org.scalameta", "junit-interface"),
        ("junit", "junit"),
        ("org.hamcrest", "hamcrest-core")
      ),
    mvn"org.tpolecat::natchez-core:0.3.10",
    // For the jsonb columns this module reads and writes as structured data (result.scores).
    // Already inside the deployed jar by way of `api`, so this costs nothing there.
    mvn"com.lihaoyi::upickle:4.0.2"
  )

  object test extends ScalaTests with TestModule.Munit {
    def mvnDeps = Seq(
      mvn"org.scalameta::munit:1.0.4",
      mvn"org.scalameta::munit-scalacheck:1.0.0",
      mvn"org.typelevel::otel4s-core-trace:0.11.2",
      mvn"org.typelevel::otel4s-core-metrics:0.11.2",
      mvn"org.flywaydb:flyway-core:13.0.0",
      mvn"org.flywaydb:flyway-database-postgresql:13.0.0",
      mvn"org.postgresql:postgresql:42.7.13"
    )

    /** Brings the local test database up to date, once, before any test JVM starts.
      *
      * The specs used to do this themselves, and mill forks several JVMs per run, so Flyway ran
      * once in each of them — every one validating the same nine migrations, and all of them
      * starting at the same moment. Flyway's own locking makes that safe, but it is repeated
      * work at the point where every suite is already contending for connections, and it buried
      * the test output in migration banners.
      *
      * Re-run on every invocation, via the always-changing input below: the database is not one
      * of mill's inputs, so a plain cached task would be skipped on the run after someone
      * dropped the schema by hand — which is exactly the run that needs it. The module reused
      * here is the same `Migrate` that `flyway-dev.sh` runs, so the tests and the deployment
      * apply migrations one way.
      */
    def migrated = Task {
      everyInvocation()
      mill.util.Jvm.callProcess(
        mainClass = "com.vivi.matchmaker.flyway.Migrate",
        classPath = matchmaker.flyway.runClasspath().map(_.path),
        env = Map(
          "FLYWAY_PASSWORD" -> "matchmaker",
          // Absolute, because this runs in the task's own directory: a `Task` may only write
          // inside `Task.dest`, so it cannot be given the workspace as its working directory
          // and cannot use `Migrate`'s workspace-relative default.
          "MIGRATION_DIR" -> (mill.api.BuildCtx.workspaceRoot / "matchmaker" / "resources" / "db" / "migration").toString
        ),
        cwd = Task.dest,
        stdout = os.Inherit
      )
      ()
    }

    /* Nothing about the database can be expressed as a mill input, so this stands in for it:
     * a value that differs every time it is asked for, which is what stops the migration above
     * from being cached and skipped. */
    def everyInvocation = Task.Input { System.nanoTime() }

    /* The migration is a dependency of the forked JVMs' environment, which is what makes it
     * happen before they start; the variable is how `TestMigration` knows not to do it again. */
    def forkEnv = Task {
      migrated()
      super.forkEnv() + ("MATCHMAKER_TEST_MIGRATED" -> "1")
    }
  }

  /** The HTTP API, packaged as an AWS Lambda behind an API Gateway HTTP API.
    *
    * Deployable jar: `mill matchmaker.api.assembly`, whose handler is
    * `com.vivi.matchmaker.api.Handler::handleRequest`.
    *
    * `aws-lambda-java-events` is deliberately absent, to keep the cold start short: it would
    * pull in Jackson purely to model the event, which `ApiGateway` picks apart with ujson
    * instead. The same argument is why nothing here uses an AWS *service* client — that is what
    * brings in Netty and Apache HttpClient (8 MB). Nothing in this module reaches AWS at all: the
    * game engine is authenticated with a shared API key rather than SigV4, so the signer that
    * used to be here is gone with it.
    */
  object api extends ScalaModule {
    def scalaVersion = "3.3.8"
    def moduleDeps = Seq(matchmaker)
    def mvnDeps = Seq(
      mvn"com.amazonaws:aws-lambda-java-core:1.2.3",
      mvn"com.lihaoyi::upickle:4.0.2"
    )

    // Json.scala lives in shared/, compiled here and again for the UI. The model directory is
    // already on this module's path through `matchmaker`, so only the former is added.
    def sources = Task.Sources(moduleDir / "src", sharedSources(moduleDir).head)

    /** TASTy files carry Scala 3 signatures for compiling *against* this jar. Nothing compiles
      * against a Lambda artifact, and they are a fifth of its size.
      */
    def assemblyRules = super.assemblyRules ++ Seq(Assembly.Rule.ExcludePattern(".*\\.tasty"))

    object test extends ScalaTests with TestModule.Munit {
      def mvnDeps = Seq(
        mvn"org.scalameta::munit:1.0.4",
        mvn"org.typelevel::otel4s-core-trace:0.11.2",
        mvn"org.typelevel::otel4s-core-metrics:0.11.2"
      )
    }
  }

  /** The browser UI: Scala.js and Laminar, talking to the same HTTP API as any other client.
    *
    * `mill matchmaker.ui.fastLinkJS` for development, `fullLinkJS` for a deployable bundle; both
    * write `main.js` into their own out directory, which `ui/index.html` loads. There is no
    * bundler and no npm: Laminar and scalajs-dom are Scala libraries, and the only browser APIs
    * used (fetch, crypto.subtle, sessionStorage) are standard.
    *
    * It compiles the model and the API's `Json` codecs from source rather than depending on
    * `matchmaker`, which cannot cross-compile — skunk and cats-effect are JVM-only.
    */
  object ui extends ScalaJSModule {
    def scalaVersion = "3.3.8"
    def scalaJSVersion = "1.17.0"

    def sources = Task.Sources(Seq(moduleDir / "src") ++ sharedSources(moduleDir)*)

    def mvnDeps = Seq(
      mvn"org.scala-js::scalajs-dom::2.8.0",
      mvn"com.raquo::laminar::17.2.0",
      mvn"com.lihaoyi::upickle::4.0.2",
      // The shared model uses java.time, which Scala.js does not implement itself.
      mvn"io.github.cquiroz::scala-java-time::2.6.0"
    )

    /** A module rather than a plain script, so that `fullLinkJS` can split output and so that
      * `index.html` can `import` it — Scala.js's default is a single non-module script, which
      * cannot be loaded with `type="module"`.
      */
    def moduleKind = mill.scalajslib.api.ModuleKind.ESModule

    object test extends ScalaJSTests with TestModule.Munit {
      def mvnDeps = Seq(mvn"org.scalameta::munit::1.0.4")
    }
  }

  /** Standalone module used only to run Flyway migrations (JDBC-based,
    * independent of the skunk/cats-effect runtime dependencies above).
    * Migration scripts live in matchmaker/resources/db/migration and are
    * shared via that resources directory (matchmaker's default resource path).
    */
  object flyway extends ScalaModule {
    def scalaVersion = "3.3.8"
    def mvnDeps = Seq(
      mvn"org.flywaydb:flyway-core:10.20.1",
      mvn"org.flywaydb:flyway-database-postgresql:10.20.1",
      mvn"org.postgresql:postgresql:42.7.4"
    )

    /** Run pending migrations against the database given by env vars
      * FLYWAY_URL, FLYWAY_USER, FLYWAY_PASSWORD, e.g.:
      *
      *   FLYWAY_URL=jdbc:postgresql://localhost:5432/matchmaker \
      *   FLYWAY_USER=matchmaker FLYWAY_PASSWORD=secret \
      *   ./mill matchmaker.flyway.runMain com.vivi.matchmaker.flyway.Migrate
      *
      * SeedAdmin runs the same way, on the same variables plus
      * ADMIN_EXTERNAL_ID, to give the admin Cognito user a player row.
      */
    object test extends ScalaTests with TestModule.Munit {
      def mvnDeps = Seq(mvn"org.scalameta::munit::1.0.4")
    }
  }
}

/** Game engines to develop and test matchmaker's engine interaction against.
  *
  * These are not part of matchmaker: an engine is a separate system reached over HTTP, and
  * nothing here depends on the `matchmaker` module — deliberately, since sharing the wire
  * types would hide exactly the mismatches this code exists to catch. They live in the same
  * repository only because they are worth nothing on their own.
  */
object engines extends Module {

  /** Two-player tic-tac-toe, implementing the game API of `interaction-design.txt`.
    *
    * `mill -j 4 engines.tictactoe.runMain com.vivi.tictactoe.LocalServer` runs it locally;
    * `mill -j 4 engines.tictactoe.assembly` builds the Lambda jar, whose handler is
    * `com.vivi.tictactoe.Handler::handleRequest`.
    */
  object tictactoe extends ScalaModule {
    def scalaVersion = "3.3.8"

    def mvnDeps = Seq(
      mvn"com.lihaoyi::upickle:4.0.2",
      mvn"com.amazonaws:aws-lambda-java-core:1.2.3",
      // Signs the engine's calls to DynamoDB, and only those — its callbacks to matchmaker carry
      // a shared API key instead. The signer only: a DynamoDB client would bring Netty with it.
      mvn"software.amazon.awssdk:http-auth-aws:2.31.78",
      mvn"org.slf4j:slf4j-nop:1.7.36"
    )

    def assemblyRules = super.assemblyRules ++ Seq(Assembly.Rule.ExcludePattern(".*\\.tasty"))

    /** The engine's tests, and only its tests, depend on matchmaker.
      *
      * `ProtocolSpec` reads the engine's JSON with matchmaker's own classes and matchmaker's with
      * the engine's, which is the check the restated wire types exist for: it fails when a field
      * is renamed on one side, and it is the reason the engine itself can stay independent.
      */
    object test extends ScalaTests with TestModule.Munit {
      def moduleDeps = super.moduleDeps ++ Seq(matchmaker.api)
      def mvnDeps = Seq(
        mvn"org.scalameta::munit:1.0.4",
        mvn"org.scalameta::munit-scalacheck:1.0.0"
      )
    }
  }
}
